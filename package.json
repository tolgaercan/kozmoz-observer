{
  "name": "kozmoz-observer",
  "version": "1.0.0",
  "description": "Kozmoz API Observer — GetClosedDate polling with control panel",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "powershell -ExecutionPolicy Bypass -File scripts/start-panel.ps1",
    "panel": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs src/control-panel/server.ts",
    "chrome:debug": "powershell -ExecutionPolicy Bypass -File scripts/start-chrome-debug.ps1",
    "chrome:seed-profile": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs src/browser/seedChromeProfile.ts",
    "scenario": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs src/scenarios/runScenario.ts",
    "scenario:api-watcher-attach": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs src/scenarios/runScenario.ts --id api-watcher-attach --profile profile-1 --no-wait",
    "scenario:api-watcher-eea": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs src/scenarios/runScenario.ts --id api-watcher-attach --profile profile-2 --no-wait",
    "chrome:debug:profile-2": "powershell -ExecutionPolicy Bypass -File scripts/start-chrome-debug.ps1 -Profile profile-2",
    "validate:api-dates": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/validate-api-date-logic.ts",
    "compare:appointment-types": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/compare-appointment-types.ts"
  },
  "keywords": [
    "playwright",
    "api",
    "visa",
    "automation"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "playwright": "^1.49.1"
  }
}
