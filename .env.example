# Kozmoz API Observer — örnek yapılandırma
# UI observer / kayıt formu şablonları: archive/env/

VISA_PORTAL_HOME_URL=https://basvuru.kosmosvize.com.tr/
# JWT bootstrap — opsiyonel URL override
# KOSMOS_MARKETING_HOME_URL=https://www.kosmosvize.com.tr/
# PORTAL_APPOINTMENT_FORM_URL=https://basvuru.kosmosvize.com.tr/appointmentForm
DEFAULT_PROFILE_ID=profile-1

# ── Chrome CDP (önerilen: cdp attach) ──
BROWSER_CONNECT=cdp
CDP_ENDPOINT=http://127.0.0.1:9222
BROWSER_MODE=isolated
CDP_USE_MANIFEST_PROFILE=true
CDP_PORT=9222
CHROME_PROFILE_GATE_ENABLED=false
CHROME_STARTUP_URL=about:blank
CHROME_FRESH_START=false
CHROME_FRESH_PROFILE=false
BROWSER_CHANNEL=chrome
PRE_GOTO_DELAY_MS=2500

# ── Ağ ──
# Ev WAN IP — ProxyNet kapalıyken ipify ile de ölçülür
# HOME_PUBLIC_IP=
# Proxy havuzu: data/config/proxy-pool.local.json

# ── Portal oturumu (JWT bootstrap) ──
# EMAIL_PROFILE_1=your@email.com
# PASSWORD_PROFILE_1=yourpassword

INTERVENTION_LOGIN_WAIT_MS=1800000
CAPTCHA_ENABLED=true
CAPTCHA_POLL_INTERVAL_MS=4000
CAPTCHA_MAX_WAIT_MS=180000
# API_TOKEN_CAPTURE_WAIT_MS=45000

# ── Telegram ──
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Ek hedefler (virgulle) — davet linki degil, sayisal chat_id
# TELEGRAM_EXTRA_CHAT_IDS=-100111,-100222
# veya tek satirda: TELEGRAM_CHAT_IDS=-5494642849,-100111
TELEGRAM_NOTIFY_ON_RESOLVED=false
TELEGRAM_NOTIFY_COOLDOWN_MS=300000
TELEGRAM_TLS_INSECURE=false

# ── API Watcher ──
API_WATCHER_ENABLED=true
API_BASE_URL=https://api.kosmosvize.com.tr
API_GET_CLOSED_DATE_URL=https://api.kosmosvize.com.tr/api/AppointmentClosedDates/GetClosedDate?dealerId={dealerId}&date={date}&maxDate={maxDate}&appointmentTypeId={appointmentTypeId}
API_HOUR_QUOTA_ENABLED=false
API_REFERER=https://basvuru.kosmosvize.com.tr/appointmentForm
API_DEALER_ID=1014
# API_DEALER_OFFICE=Ankara
# GetClosedDate maxDate kaynağı (varsayılan api = AdminDatas/2329)
# API_GET_MAX_APPOINTMENT_DATE_URL=https://api.kosmosvize.com.tr/api/AdminDatas/GetDatasById?id={adminDataId}
# API_MAX_APPOINTMENT_DATE_ADMIN_DATA_ID=2329
# API_CLOSED_DATE_MAX_MODE=api|portal|offset
# portal = ertesi ayın 1'i (fallback) | offset = date + API_CLOSED_DATE_RANGE_DAYS
# API_CLOSED_DATE_MAX_MODE=portal
# API_CLOSED_DATE_MAX_MODE=offset
# API_CLOSED_DATE_RANGE_DAYS=26
# API_CLOSED_DATE_MAX=2026-09-01
API_CLOSED_DATE_RANGE_DAYS=26
API_CITY_ID=1
# Standart=16 | EEA AB Eşi=2339
# API_APPOINTMENT_TYPE_ID=16
API_POLL_INTERVAL_MS=300000
# Poll oncesi Chrome appointmentForm dropdown'unu panel typeId ile eslestir (varsayilan acik)
# API watcher wizard: MAX adim 2 — adim 3 (bilgi/TC) ve takvim YASAK (captcha/rate limit)
# Adim 1: il + merkez → tek Sonraki | Adim 2: tip + sekli — Sonraki YOK (adim 3 captcha)
# API_WIZARD_ADVANCE_FROM_STEP1 artik kullanilmiyor — adim 2 icin gecis her zaman gerekli
# API_APPOINTMENT_TYPE_WIZARD_STEP=2
# API_SYNC_PORTAL_APPOINTMENT_TYPE=false
# API_SYNC_PORTAL_APPOINTMENT_TYPE_WAIT_MS=800
# Otomatik appointmentForm acma — false/onemsiz = kapali (Cloudflare ban onlemi, onerilen)
# Akis: panel Chrome'unda ELLE portala git → watcher baslat → UI token → browser poll
# API_AUTO_OPEN_PORTAL_TAB=false
API_TELEGRAM_REPORT_ENABLED=true
API_TELEGRAM_REPORT_INTERVAL_MS=300000
API_OPEN_NOTIFY_COOLDOWN_MS=300000
# API_BEARER_TOKEN=
# API_DECRYPT_PASSPHRASE=

# Panel: CONTROL_PANEL_PORT=8787

# ── Arşiv (aktif akışta gerekmez) ──
# UI observer: archive/env/ui-observer.env.template
# Kayıt formu: archive/env/register-wizard-profile-1.template
