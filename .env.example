# Vize portalı
VISA_PORTAL_HOME_URL=https://basvuru.kosmosvize.com.tr/
# Opsiyonel — observer doğrudan randevu sayfasına gider (varsayilan: .../appointmentProcedures)
# PORTAL_APPOINTMENT_PROCEDURES_URL=https://basvuru.kosmosvize.com.tr/appointmentProcedures
# PORTAL_REGISTER_FORM_URL=https://basvuru.kosmosvize.com.tr/registerform
DEFAULT_PROFILE_ID=profile-1
# Varsayılan test senaryosu / akış ID
DEFAULT_FLOW_ID=kosmos-observe-v1

# Portal giriş (bootstrap — Adım B)
# EMAIL_PROFILE_1=your@email.com
# PASSWORD_PROFILE_1=yourpassword

# --- profile-2 (Bireysel + EEA AB Eşi başvuru şekli — slot algoritma doğrulama) ---
# EMAIL_PROFILE_2=
# PASSWORD_PROFILE_2=
# NATIONALITY_NUMBER_PROFILE_2=
# Portal Başvuru Şekli seçenekleri: Standart | Vip | EEA AB Eşi | Business Trip
# APPOINTMENT_STYLE_PROFILE_2=EEA AB Eşi
# Senaryo: npm run chrome:debug:profile-2  →  npm run scenario:eea-observe-attach

# Kayıt formu wizard alanları — wizard adımına göre paketlenmiş tam şablon:
#   env/register-wizard-profile-1.template
# Her alanın üstünde form alanı adı, zorunluluk ve dropdown seçenekleri (kısaltmadan) yazılıdır.
# .env dosyanızda aynı yapıyı kopyalayıp değerleri doldurun.
#
# Wizard Adım 3 özeti (İletişim / İkamet):
# APPLICANT_COUNTRY_PROFILE_1=685
# APPLICANT_CITY_PROFILE_1=Ankara   (tam il listesi şablonda)
# STREET_PROFILE_1=Sokak cadde
# REGISTER_EMAIL_PROFILE_1=          (boş = EMAIL_PROFILE_1)
# PHONE_PROFILE_1=5555555555       (başında 0 yok)
# RESIDENCE_ABROAD_PROFILE_1=Hayır (Hayır | Evet)

# Sabit Chrome profili (eklenti zaten kurulu)
# launch = Playwright Chrome başlatır (CF ban riski yüksek)
# cdp = açık Chrome'a bağlanır (ÖNERİLEN)
BROWSER_CONNECT=cdp
CDP_ENDPOINT=http://127.0.0.1:9222

BROWSER_MODE=isolated
CDP_USE_MANIFEST_PROFILE=true
CHROME_PROFILE_GATE_ENABLED=false
CHROME_STARTUP_URL=about:blank
# true = her observer başında çerez temizle (tam temiz portal girişi)
CHROME_FRESH_START=false
# true = her chrome:debug temiz profil | false = oturumu koru (reuse)
CHROME_FRESH_PROFILE=false
# full = Chrome/Google + portal + randevu (varsayilan) | chrome-profile = sadece Google girisi
OBSERVER_PHASE=full
CDP_PORT=9222

BROWSER_CHANNEL=chrome
PRE_GOTO_DELAY_MS=2500

# Sayfa yüklendikten sonra hedefe insan benzeri tıklama
AUTO_NAV_ENABLED=true
# Adım 1: üst menü | Adım 2: sekme (NAV_STEPS ile tüm akış da yazılabilir: loc1|loc2;loc3)
NAV_TARGET_LOCATOR=li.nav-link a[href='/appointmentProcedures']:visible|a[href='/appointmentProcedures']:visible|li.nav-link span.nav-item-title:has-text('Randevu İşlemleri')
NAV_STEP_2_LOCATOR=a.tab-link:visible:has-text('Randevu Al')|a[href='/appointmentForm']:visible|a:visible:has-text('Randevu Al')
NAV_WAIT_AFTER_LOAD_MS=600
NAV_WAIT_BETWEEN_STEPS_MS=900
NAV_LOCATOR_TIMEOUT_MS=60000

AUTO_CITY_SELECT_ENABLED=true
APPOINTMENT_CITY=Ankara
CITY_SELECT_LOCATOR=#cities|select[name='cities']|div.select-city select
CITY_SCROLL_LOCATOR=div.select-city|#cities
CITY_SELECT_TIMEOUT_MS=60000
CITY_WAIT_AFTER_NAV_MS=1200
CITY_WAIT_AFTER_SELECT_MS=700
APPOINTMENT_BLANK_CLICK_ENABLED=true
APPOINTMENT_HEADER_LOCATOR=div.sp-blue-header|text=Seçilen İl
LOCATION_BUTTON_ENABLED=true
LOCATION_BUTTON_CONTAINER=#buttonContainer
LOCATION_BUTTON_SELECTOR=.sp-selectable-button
WIZARD_NEXT_ENABLED=true
WIZARD_NEXT_LOCATOR=button.wizard-btn:has-text('Sonraki')|.wizard-footer-right button:has-text('Sonraki')|role=button[name='Sonraki']
WIZARD_NEXT_WAIT_MS=600

# Başvuru tipi — manifest applicationType veya APPLICATION_TYPE (Bireysel | Aile)
APPLICATION_TYPE_ENABLED=true
APPLICATION_TYPE=Bireysel
APPLICATION_TYPE_LOCATOR=select[name='applicationTypeId']|select.form-select:has(option:text('Bireysel'))
APPLICATION_TYPE_TIMEOUT_MS=30000
APPLICATION_TYPE_WAIT_AFTER_NEXT_MS=800

# TC Kimlik — NATIONALITY_NUMBER_PROFILE_1 > manifest > NATIONALITY_NUMBER
NATIONALITY_NUMBER_ENABLED=true
NATIONALITY_NUMBER=
# NATIONALITY_NUMBER_PROFILE_1=12345678901
NATIONALITY_NUMBER_LOCATOR=input[name='nationalityNumber']|input.form-control[name='nationalityNumber']
NATIONALITY_NUMBER_TIMEOUT_MS=30000
NATIONALITY_NUMBER_WAIT_AFTER_TYPE_MS=800
NATIONALITY_NUMBER_BLANK_CLICK_ENABLED=true
NATIONALITY_NUMBER_WAIT_AFTER_INPUT_MS=400
HUMAN_TYPE_MIN_CHAR_MS=95
HUMAN_TYPE_MAX_CHAR_MS=200
HUMAN_TYPE_GROUP_EVERY_CHARS=3
HUMAN_TYPE_GROUP_PAUSE_MIN_MS=220
HUMAN_TYPE_GROUP_PAUSE_MAX_MS=520

# Başvuru şekli — APPOINTMENT_STYLE_PROFILE_1 > manifest > APPOINTMENT_STYLE (Standart | Vip | ...)
APPOINTMENT_STYLE_ENABLED=true
APPOINTMENT_STYLE=Standart
APPOINTMENT_STYLE_LOCATOR=select[name='appointmentTypeId']|select.form-select:has(option:text('Standart'))
APPOINTMENT_STYLE_TIMEOUT_MS=30000
APPOINTMENT_STYLE_WAIT_AFTER_TC_MS=600

# Wizard adım algılama — URL sabit; ul.wizard-nav-pills üzerinden adım okunur
WIZARD_NAV_LOCATOR=ul.wizard-nav-pills|ul.wizard-nav
WIZARD_AUTO_RECOVER_ENABLED=true
WIZARD_RECOVER_CHECK_INTERVAL_MS=12000
WIZARD_WAIT_AFTER_STEP_MS=900

# Randevu günü gözlemi (adım 3 takvim)
SLOT_WATCH_ENABLED=true
SLOT_WATCH_INTERVAL_MS=60000
SLOT_MONTHS_AHEAD=1
SLOT_MONTH_NAV_WAIT_MS=800
SLOT_CALENDAR_NEXT_LOCATOR=button[data-dp-element='action-next']|button[aria-label='Next month']
SLOT_CALENDAR_PREV_LOCATOR=button[data-dp-element='action-prev']|button[aria-label='Previous month']
SLOT_CALENDAR_LOCATOR=.dp__calendar|div.dp__main
SLOT_AVAILABLE_CELL_SELECTOR=.dp__cell_inner.dp__pointer
SLOT_VERIFY_BY_CLICK=true
SLOT_VERIFY_MODE=single-only
SLOT_DAY_CLICK_WAIT_MS=900
SLOT_TIME_BUTTON_SELECTOR=.appointment-hours-container button.btn|.appointment-hours-container button
SLOT_EMPTY_TIME_MESSAGE=Bu gün için randevu bulunmamaktadır
SLOT_NOTIFY_ON_CHANGE=false
SLOT_NOTIFY_ON_EMPTY=true
SLOT_NOTIFY_EMPTY_COOLDOWN_MS=1800000
SLOT_NOTIFY_SLOTS_COOLDOWN_MS=300000
SLOT_NOTIFY_COOLDOWN_MS=300000
RECAPTCHA_WAIT_MS=90000
RECAPTCHA_POLL_INTERVAL_MS=3000
RECAPTCHA_PROACTIVE_REFRESH_ENABLED=false
# false = ay ileri/geri sadece SLOT_WATCH döngüsünde (önerilen, çakışma yok)
RECAPTCHA_PROACTIVE_REFRESH_INTERVAL_MS=45000
RECAPTCHA_PROACTIVE_REFRESH_MODE=month-nav
RECAPTCHA_PROACTIVE_WAIT_MS=30000
RECAPTCHA_PROACTIVE_MIN_TOKEN_AGE_MS=50000
CAPTCHA_RECOVERY_ENABLED=true
# wizard-nav = üst wizard sekmesi (adım 2) → takvim | prev-next = Önceki/Sonraki butonları
CAPTCHA_RECOVERY_MODE=wizard-nav
CAPTCHA_RECOVERY_WIZARD_STEP=2
# Boş tık captcha widget'ını yeniden açabilir — wizard-nav modunda kapalı bırakın
CAPTCHA_RECOVERY_BLANK_CLICK=false
CAPTCHA_RECOVERY_TRY_PREV_NEXT=true
CAPTCHA_RECOVERY_TRY_REFRESH=true
CAPTCHA_RECOVERY_STEP_WAIT_MS=1500
# Token dolunca iframe yok sayilir; cozulmezse wizard-nav kurtarma
CAPTCHA_ESCAPE_MS=60000
CAPTCHA_STABLE_SOLVE_MS=1000
WIZARD_PREVIOUS_LOCATOR=button.wizard-btn:has-text('Önceki')|.wizard-footer-left button:has-text('Önceki')|role=button[name='Önceki']

HUMAN_MOUSE_MIN_STEP_MS=4
HUMAN_MOUSE_MAX_STEP_MS=14
HUMAN_MOUSE_OVERSHOOT_PROB=0.18

CAPTCHA_MODE=fixed-browser
CAPTCHA_ENABLED=true
CAPTCHA_POLL_INTERVAL_MS=4000
CAPTCHA_MAX_WAIT_MS=180000
CAPTCHA_WATCH_INTERVAL_MS=8000
INTERVENTION_LOGIN_WAIT_MS=1800000

# Telegram — @BotFather ile bot oluştur, chat ID al
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_ON_RESOLVED=false
TELEGRAM_NOTIFY_COOLDOWN_MS=300000
# Antivirüs/kurumsal proxy TLS hatasında (UNABLE_TO_VERIFY_LEAF_SIGNATURE) true yapın
TELEGRAM_TLS_INSECURE=false

# --- API Watcher (kosmos-api-watcher-v1 — observe akışından ayrı) ---
# Senaryo: npm run chrome:debug:profile-api  →  npm run scenario:api-watcher-attach
API_WATCHER_ENABLED=true
API_BASE_URL=https://api.kosmosvize.com.tr
# URL şablonu — portal Network ile aynı parametreler:
# GetClosedDate?dealerId={dealerId}&date={date}&maxDate={maxDate}&appointmentTypeId={appointmentTypeId}
API_GET_CLOSED_DATE_URL=https://api.kosmosvize.com.tr/api/AppointmentClosedDates/GetClosedDate?dealerId={dealerId}&date={date}&maxDate={maxDate}&appointmentTypeId={appointmentTypeId}
API_GET_HOUR_QUOTA_URL=https://api.kosmosvize.com.tr/api/Appointment/GetAppointmentHourQoutaInfo?cityId={cityId}&appointmentTypeId={appointmentTypeId}&applicationTypeId={applicationTypeId}&appointmentDate={appointmentDate}
# Saat kotası — varsayılan kapalı (checkHourQuota hazır; watcher otomatik tetiklemez)
API_HOUR_QUOTA_ENABLED=false
API_REFERER=https://basvuru.kosmosvize.com.tr/registerform
# GetClosedDate dealerId — doğrudan ID veya ofis adı (API_DEALER_OFFICE)
API_DEALER_ID=1014
# API_DEALER_OFFICE=Antalya
# API_DEALER_OFFICE_PROFILE_2=Gaziantep
# Kapalı gün aralığı — maxDate = bugün + N gün (portal örneği: 43 gün)
API_CLOSED_DATE_RANGE_DAYS=43
# API_CLOSED_DATE=2026-07-20
# API_CLOSED_DATE_MAX=2026-09-01
# Eski/alternatif cityId endpoint için (HourQouta vb.)
API_CITY_ID=1
# Başvuru şekli ID — etiket veya doğrudan ID:
# Standart=16 | Vip=18 | EEA AB Eşi=2339 | Business Trip=2472
# APPOINTMENT_STYLE=EEA AB Eşi
# API_APPOINTMENT_TYPE_ID=2339
# API_APPOINTMENT_TYPE_ID_PROFILE_2=2339
# Başvuru tipi — yalnızca GetAppointmentHourQoutaInfo için (GetClosedDate kullanmaz)
# API_APPLICATION_TYPE_ID=1
# Poll aralığı — 120000ms = 2 dk ≈ 30 istek/saat (429 rate limit için güvenli)
API_POLL_INTERVAL_MS=120000
# HTTP 429 sonrası varsayılan bekleme (ms). Portal mesajından süre parse edilemezse kullanılır (1 saat).
# API_RATE_LIMIT_BACKOFF_MS=3600000
# API watcher Telegram özeti (aktif gün listesi) — TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID gerekir
API_TELEGRAM_REPORT_ENABLED=true
API_TELEGRAM_REPORT_INTERVAL_MS=120000
API_OPEN_NOTIFY_COOLDOWN_MS=300000
API_TOKEN_CAPTURE_WAIT_MS=45000
API_CAPTCHA_FALLBACK_BROWSER=false
# Opsiyonel: login/bootstrap yerine doğrudan JWT (hardcode yok — sadece .env)
# API_BEARER_TOKEN=
# API_BEARER_TOKEN_PROFILE_API=
# Portal index-*.js cipher passphrase (CryptoJS AES) — DevTools Sources'tan çıkarın
# API_DECRYPT_PASSPHRASE=
# EMAIL_PROFILE_API=
# PASSWORD_PROFILE_API=
